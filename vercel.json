{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter ./artifacts/sanovim run build",
  "outputDirectory": "artifacts/sanovim/dist/public",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://sanovim.onrender.com/api/:path*" },
    { "source": "/q/:path*", "destination": "https://sanovim.onrender.com/q/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
