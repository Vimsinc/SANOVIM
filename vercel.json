{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter ./artifacts/sanovim run build && pnpm --filter ./artifacts/api-server run build:serverless",
  "outputDirectory": "artifacts/sanovim/dist/public",
  "functions": {
    "api/[...path].mjs": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
